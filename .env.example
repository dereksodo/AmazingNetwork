# Every setting of the product. Copy to .env (git-ignored) and adjust; never commit real secrets.

# Backend
CONNECT_DATABASE_URL=sqlite:///./connect.db
CONNECT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONNECT_EMAIL_DOMAIN=campus.example

# Model for report triage: any server with an OpenAI-compatible /chat/completions endpoint.
# LM Studio (default): start its local server and load the model below; no key is needed.
# DeepSeek: CONNECT_LLM_BASE_URL=https://api.deepseek.com, CONNECT_LLM_MODEL=deepseek-chat and your key.
CONNECT_LLM_BASE_URL=http://localhost:1234/v1
CONNECT_LLM_MODEL=qwen/qwen3-4b
CONNECT_LLM_API_KEY=
CONNECT_LLM_TIMEOUT_SECONDS=20

# Frontend development server: where it forwards /api and /ws
CONNECT_API_URL=http://127.0.0.1:8000
