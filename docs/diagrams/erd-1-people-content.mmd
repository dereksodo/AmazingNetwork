%% Entity relationship diagram, part 1 — people, communities and published content
%% Entities drawn without attributes are defined in another part.
erDiagram
  USER ||--o{ MEMBERSHIP : "has"
  COMMUNITY ||--o{ MEMBERSHIP : "has"
  USER ||--o{ FOLLOW : "follows"
  USER ||--o{ BLOCK : "blocks"
  USER ||--o{ POST : "writes"
  COMMUNITY |o--o{ POST : "contains"
  POST ||--o| EVENT : "details"
  EVENT ||--o{ RSVP : "receives"
  USER ||--o{ RSVP : "makes"
  POST ||--o{ COMMENT : "has"
  COMMENT |o--o{ COMMENT : "reply to"
  POST ||--o{ REACTION : "has"

  USER {
    uuid id PK
    text email UK "university domain only"
    text display_name
    enum global_role "user | moderator | admin"
    bool approve_followers
    timestamptz deleted_at "null unless deletion requested"
  }
  COMMUNITY {
    bigint id PK
    text name UK
    enum join_policy "open | closed"
    enum status "pending | approved | rejected"
    uuid created_by FK
    uuid approved_by FK "admin"
  }
  MEMBERSHIP {
    uuid user_id PK,FK
    bigint community_id PK,FK
    enum role "member | officer | owner"
    enum status "pending | active"
  }
  FOLLOW {
    uuid follower_id PK,FK
    uuid followed_id PK,FK
    enum status "pending | active"
  }
  BLOCK {
    uuid blocker_id PK,FK
    uuid blocked_id PK,FK
  }
  POST {
    bigint id PK
    uuid author_id FK
    bigint community_id FK "nullable"
    enum type "post | discussion | announcement | event"
    enum visibility "campus | community | followers"
    text title "required for discussion, event"
    text body_html "sanitized"
    enum status "visible | hidden | removed"
    bool comments_enabled
    bool locked
    bool pinned
    int version
    timestamptz created_at
  }
  EVENT {
    bigint post_id PK,FK
    timestamptz starts_at
    timestamptz ends_at "CHECK ends_at > starts_at"
    text location
    int capacity "CHECK > 0"
    timestamptz rsvp_deadline
  }
  RSVP {
    bigint event_id PK,FK
    uuid user_id PK,FK
    enum status "going | interested | waitlisted"
    timestamptz created_at "waitlist order"
  }
  COMMENT {
    bigint id PK
    bigint post_id FK
    bigint parent_id FK "one level only"
    uuid author_id FK
    text body "max 1000"
    enum status "visible | hidden | removed"
  }
  REACTION {
    bigint post_id PK,FK
    uuid user_id PK,FK
    enum kind PK "like | love | celebrate | think"
  }
