%% ER diagram: published content. Generated by backend/scripts/export_erd.py
erDiagram
  POST ||--o{ COMMENT : post_id
  COMMENT |o--o{ COMMENT : parent_id
  USER ||--o{ COMMENT : author_id
  POST ||--o| EVENT : post_id
  USER ||--o{ POST : author_id
  COMMUNITY |o--o{ POST : community_id
  POST |o--o{ POST : reshare_of_id
  POST ||--o{ POST_IMAGE : post_id
  POST ||--o{ POST_VERSION : post_id
  POST ||--o{ REACTION : post_id
  USER ||--o{ REACTION : user_id
  EVENT ||--o{ RSVP : event_id
  USER ||--o{ RSVP : user_id
  COMMENT {
    integer id PK
    integer post_id FK
    integer parent_id FK "nullable"
    integer author_id FK
    string body
    string status
    utcdatetime created_at
    utcdatetime edited_at  "nullable"
    utcdatetime removed_at  "nullable"
  }
  EVENT {
    integer post_id PK,FK
    utcdatetime starts_at
    utcdatetime ends_at
    string location
    integer capacity
    utcdatetime rsvp_deadline
    boolean cancelled
  }
  POST {
    integer id PK
    integer author_id FK
    integer community_id FK "nullable"
    integer reshare_of_id FK "nullable"
    string type
    string visibility
    string title  "nullable"
    string body_html
    string status
    boolean comments_enabled
    boolean locked
    boolean pinned
    integer version
    utcdatetime created_at
    utcdatetime edited_at  "nullable"
    utcdatetime removed_at  "nullable"
  }
  POST_IMAGE {
    integer id PK
    integer post_id FK
    string content_type
    string alt_text
    blob data
  }
  POST_VERSION {
    integer post_id PK,FK
    integer version PK
    string title  "nullable"
    string body_html
    string visibility
    utcdatetime replaced_at
  }
  REACTION {
    integer post_id PK,FK
    integer user_id PK,FK
    string kind PK
  }
  RSVP {
    integer event_id PK,FK
    integer user_id PK,FK
    string status
    utcdatetime created_at
  }
