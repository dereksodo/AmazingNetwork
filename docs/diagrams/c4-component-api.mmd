%% C4 Level 3 — Components inside the API Application (C-API), as built. Names in italics are packages of backend/app.
flowchart TB
  web["<b>Web App</b> (C-WEB)<br/><i>[Container: React]</i>"]
  subgraph api["API Application (C-API) — FastAPI"]
    direction TB
    subgraph entry["Entry points"]
      direction LR
      routers["<b>REST routers</b><br/><i>router.py in each package</i><br/>validation, uniform errors"]
      auth["<b>Auth & Session</b> (K-AUTH)<br/><i>auth</i><br/>sign-in, tokens, roles"]
      ws["<b>Realtime Gateway</b> (K-RT)<br/><i>realtime</i><br/>subscriptions, event bus<br/>(K-BUS); K-POLICY check per recipient"]
    end
    subgraph features["Feature modules"]
      direction LR
      people["<b>People</b> (K-PEOPLE)<br/><i>people</i><br/>profiles, follow, block"]
      comm["<b>Communities</b> (K-COMM)<br/><i>communities</i><br/>join, roles, follow, mute"]
      posts["<b>Content</b> (K-POST)<br/><i>content</i><br/>posts, versions, images, reshares,<br/>events, comments, sanitizing"]
      dm["<b>Direct Messages</b> (K-DM)<br/><i>messaging</i>"]
      collab["<b>Collaboration</b> (K-COLLAB)<br/><i>collab</i><br/>Yjs rooms and their<br/>WebSocket, publish"]
      mod["<b>Moderation</b> (K-MOD)<br/><i>moderation</i><br/>reports, actions,<br/>appeals, admin"]
    end
    subgraph shared["Shared services"]
      direction LR
      policy["<b>Audience Policy</b> (K-POLICY)<br/><i>policy.py</i><br/>one SQL visibility rule,<br/>role and mute checks"]
      notif["<b>Notifications</b> (K-NOTIF)<br/><i>notifications</i>"]
      audit["<b>Audit Logger</b> (K-AUDIT)<br/><i>audit</i>"]
      ai["<b>AI Triage</b> (K-AI)<br/><i>ai</i><br/>redact, call, validate"]
    end
    orm["<b>Models and session</b> (K-REPO)<br/><i>models, db.py</i><br/>tables; hands live events to K-BUS after the commit"]
  end
  db[("<b>Database</b> (C-DB)<br/>SQLite")]
  llm["<b>Language model server</b><br/><i>[External]</i>"]
  routers ~~~ auth ~~~ ws
  people ~~~ comm ~~~ posts ~~~ dm ~~~ collab ~~~ mod
  policy ~~~ notif ~~~ audit ~~~ ai
  web -- "HTTP / JSON (REST), WebSocket (/ws, /ws/drafts)" --> entry
  entry -- "authenticated calls" --> features
  features -- "every read / write checked; notify; audit; start triage" --> shared
  shared -- "query and store" --> orm
  orm -- "SQL" --> db
  shared -- "K-AI only: HTTP" --> llm
  classDef comp fill:#85bbf0,stroke:#5d82a8,color:#000
  classDef cont fill:#438dd5,stroke:#2e6295,color:#fff
  classDef external fill:#8a8a8a,stroke:#6b6b6b,color:#fff
  class routers,ws,auth,policy,people,comm,posts,dm,collab,mod,ai,notif,audit,orm comp
  class web,db cont
  class llm external
  style api fill:none,stroke:#438dd5,stroke-dasharray:6 4,color:#2e6295
  style entry fill:#f4f8fc,stroke:#c4d4e6
  style features fill:#f4f8fc,stroke:#c4d4e6
  style shared fill:#f4f8fc,stroke:#c4d4e6
